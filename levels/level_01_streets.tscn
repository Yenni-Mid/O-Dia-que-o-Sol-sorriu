fallback_id = "echo_porch_02"
fallback_author = "Vizinha Clara"
fallback_date = "Mês 3 após o Sorriso"
fallback_text = "Os lunáticos usam máscaras de papelão porque não conseguem parar de sorrir depois que a Epidemia da Verdade queima suas mentes. Se eles vigiam a varanda, entre agachado ou apague o lampião antes de passar pelas janelas."

[node name="EchoNote_Kitchen" parent="." unique_id=408746383 instance=ExtResource("3_3ybw4")]
