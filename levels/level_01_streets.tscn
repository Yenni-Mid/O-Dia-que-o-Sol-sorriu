script = ExtResource("15_vhs")
tape_id = "tape_tv"
tape_title = "Fita #01 — Último Boletim"
tape_lines = PackedStringArray("[Transmissão cortada]: ...as subestações de todo o país derreteram às 14:12...", "[Repórter]: Não olhem diretamente para o disco solar! Mantenham as janelas fechadas!", "[Sobreposição de Leo]: Pai, eu achei uma passagem pelo mercado até o nosso porão.")

[node name="VHSRecorder_Market" type="Area3D" parent="." unique_id=406004002]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -20.1, 0.90, 2.8)
script = ExtResource("15_vhs")
tape_id = "tape_market"
tape_title = "Fita #02 — Câmera do Mini-Mercado"
tape_lines = PackedStringArray("[Dono do Mercado]: Os de máscara cercaram o quarteirão assim que anoiteceu...", "[Estática pesada]: Atraímos dois deles para longe atirando garrafas na rua.", "[Dono do Mercado]: Tranquei o porão lá fora e escondi a chave atrás do balcão.")

[node name="VHSRecorder_Plaza" type="Area3D" parent="." unique_id=406004003]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 30.5, 0.90, 0.25)
script = ExtResource("15_vhs")
tape_id = "tape_plaza"
tape_title = "Fita #03 — Sermão do Espelho"
tape_lines = PackedStringArray("[Pregador]: Quando a noite cair, ergam suas tochas que os cegos se revelarão!", "[Cântico ao fundo]: O menino Leo subirá até a Torre Central para abrir o Espelho...", "[Ruído agudo]: Que nenhum fogo humano escape da vigília da praça.")

[node name="EchoNote" parent="." unique_id=408746381 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4.3, 4.42, 0.85)
fallback_id = "echo_leo_05"
fallback_author = "Caderno do Leo"
fallback_date = "Noite do Sequestro"
fallback_text = "Pai, eu escondi a fita na mochila. Se você conseguiu chegar ao meu quarto, olha pela janela norte... dá pra ver a Torre Central no horizonte. Os de máscara disseram que vão completar o Espelho da Alma Partida lá no topo."

[node name="EchoNote_Porch" parent="." unique_id=408746382 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.8, 0.52, 8.2)
fallback_id = "echo_porch_02"
fallback_author = "Vizinha Clara"
fallback_date = "Mês 3 após o Sorriso"
fallback_text = "Os lunáticos só saem à noite e são atraídos pelo brilho do lampião a óleo. De dia é o Sol Sorridente quem queima a mente na rua. Feche as portas atrás de você ou eles vão notar que há alguém vivo aqui dentro."

[node name="EchoNote_Kitchen" parent="." unique_id=408746383 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5.6, 0.93, -6.35)
fallback_id = "echo_kitchen_03"
fallback_author = "Bilhete Rasgado (Sem Nome)"
fallback_date = "Há 2 semanas"
fallback_text = "Levaram o filho do sargento para a torre central no centro da cidade. Deixei a chave dos fundos do Mini-Mercado lá em cima no escritório antes de fugir."

[node name="EchoNote_BusStop" parent="." unique_id=408746384 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12.5, 0.52, 10.05)
fallback_id = "echo_busstop_04"
fallback_author = "Motorista da Linha 14"
fallback_date = "Dia 4 após o Sorriso"
fallback_text = "Os postes derreteram na primeira hora. De dia este abrigo de concreto segura a luz do sol; de noite é melhor apagar o lampião ou jogar uma garrafa longe para despistar quem ronda a pracinha."

[node name="EchoNote_Basement" parent="." unique_id=408746385 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -5.5, -3.15, -1.5)
fallback_id = "echo_basement_06"
fallback_author = "Técnico da Caldeira"
fallback_date = "Mês 6 após o Sorriso"
fallback_text = "Aqui embaixo o Sol não alcança e os cultistas têm medo de descer, mas as Sombras Vivas tomaram o túnel até o Mini-Mercado. Não apague seu lampião nem por um segundo."

[node name="EchoNote_Plaza" parent="." unique_id=408746386 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 28.2, 0.52, -4.5)
fallback_id = "echo_plaza_07"
fallback_author = "Diário de Vigília"
fallback_date = "Ontem à noite"
fallback_text = "O Pregador com a máscara dourada não sai da pracinha após o anoitecer. Se ele enxergar seu lampião, o sino vai chamar todo o culto do quarteirão em cima de você."

