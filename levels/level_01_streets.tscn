fallback_text = "O tambor de fogo aqui do posto salvou nossa sanidade quando o céu rachou. Há um alçapão de esgoto nos fundos que leva direto pro pátio da escola."

[node name="EchoNote_Neighbor" parent="." unique_id=408746388 instance=ExtResource("3_3ybw4")]
