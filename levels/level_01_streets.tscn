[node name="EchoNote" parent="." unique_id=408746381 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4.3, 4.42, 0.85)
fallback_id = "echo_leo_05"
fallback_author = "Caderno do Leo"
fallback_date = "Noite do Sequestro"
fallback_text = "Pai, eu escondi a fita na mochila. Se você conseguiu chegar ao meu quarto, olha pela janela norte... dá pra ver a Torre Central no horizonte. Os de máscara disseram que vão completar o Espelho da Alma Partida lá no topo."

[node name="EchoNote_Porch" parent="." unique_id=408746382 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.8, 0.52, 8.2)
fallback_id = "echo_porch_02"
fallback_author = "Vizinha Clara"
fallback_date = "Mês 3 após o Sorriso"
fallback_text = "Os lunáticos usam máscaras de papelão porque não conseguem parar de sorrir depois que a Epidemia da Verdade queima suas mentes. Se eles vigiam a varanda, entre agachado ou apague o lampião antes de passar pelas janelas."

[node name="EchoNote_Kitchen" parent="." unique_id=408746383 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 5.6, 0.93, -6.35)
fallback_id = "echo_kitchen_03"
fallback_author = "Bilhete Rasgado (Sem Nome)"
fallback_date = "Há 2 semanas"
fallback_text = "Levaram o filho do sargento para a torre central no centro da cidade. O culto prepara o Espelho da Alma Partida para quando o sol alinhar. Fique longe da luz direta da rua e use o guarda-roupa lá em cima se alguém invadir a casa."

[node name="EchoNote_BusStop" parent="." unique_id=408746384 instance=ExtResource("3_3ybw4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 12.5, 0.52, 10.05)
fallback_id = "echo_busstop_04"
fallback_author = "Motorista da Linha 14"
fallback_date = "Dia 4 após o Sorriso"
fallback_text = "Os postes derreteram na primeira hora. Sem eletricidade, as sombras das marquises e becos começaram a respirar. O abrigo de concreto do ponto ainda segura a luz do sol — use-o para recuperar o fôlego."

