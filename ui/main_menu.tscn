[node name="ControlsLabel" type="Label" parent="ControlsPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.90, 0.82, 1)
theme_override_font_sizes/font_size = 15
text = "CONTROLES:
• WASD — Mover  |  Q / C — Espreitar esquinas
• Shift — Correr (gasta fôlego / faz barulho)
• Ctrl — Agachar (furtivo e abaixa silhueta)
• F / Botão Direito — Acender / Apagar Lampião
• G — Arremessar Garrafa (isca)  |  H — Usar Bandagem
• E — Interagir (Ecos, Óleo, Fitas, Portas, Chaves, Armários)
• Tab — Mapa Rabiscado & Diário de Ecos  |  Esc — Pausa
* DIA: Sol drena sanidade. NOITE (19h–06h): Cultistas caçam o lampião."

